{
    "folders": [{"path": "."}],
    "settings": {
        "latex-workshop.latex.recipes": [
            {"name": "pdflatex × 2", "tools": ["pdflatex", "pdflatex"]}
        ],
        "latex-workshop.latex.tools": [
            {"name": "pdflatex", "command": "pdflatex",
             "args": ["-synctex=1", "-interaction=nonstopmode", "-file-line-error", "%DOC%"]}
        ],
        "latex-workshop.latex.autoBuild.run": "onSave",
        "latex-workshop.view.pdf.viewer": "tab",
        "files.exclude": {
            "**/*.aux": true, "**/*.log": true, "**/*.synctex.gz": true,
            "**/*.fls": true, "**/*.fdb_latexmk": true, "**/*.out": true,
            "**/__pycache__": true
        },
        "files.encoding": "utf8",
        "python.defaultInterpreterPath": "python3"
    },
    "extensions": {
        "recommendations": ["james-yu.latex-workshop", "valentjn.vscode-ltex", "ms-python.python"]
    }
}
